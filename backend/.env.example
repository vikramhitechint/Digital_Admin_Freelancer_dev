# Backend Environment Variables
# Copy this to .env and fill real values — NEVER commit .env

PORT=3001
NODE_ENV=development

# Supabase (service-role key — server only, never in browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Cashfree
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_FROM=HTGE Platform <noreply@htge.in>

# Platform Defaults (also stored in DB — these are fallbacks)
DEFAULT_COMMISSION_PERCENT=10
DEFAULT_DROP_PENALTY_PERCENT=25
