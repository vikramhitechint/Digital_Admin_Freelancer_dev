// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CLIENT
  FREELANCER
}

enum ProjectStatus {
  PUBLISHED
  ONGOING
  COMPLETED
  DROPPED
  DROP_REQUESTED
}

enum PaymentType {
  ESCROW
  PENALTY_10
  REFUND_75
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?  // Hashed password
  fullName  String
  role      Role     @default(CLIENT)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  profile            Profile?
  clientProjects     Project[]           @relation("ClientProjects")
  freelancerProjects FreelancerProject[]
  messages           Message[]
  payments           Payment[]
  walletBalance      Decimal  @default(0)
}

model Profile {
  id               String  @id @default(uuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id])
  
  // Client Specific
  companyName      String?
  industry         String?
  website          String?
  bankName         String?
  accountNumber    String?
  ifscCode         String?
  branchName       String?

  // Freelancer Specific
  skills           String[] // PostgreSQL array
  experienceYears  Int?
  portfolioUrl     String?
  rating           Float?
}

model Project {
  id            String   @id @default(uuid())
  title         String
  description   String
  budget        Decimal
  status        ProjectStatus @default(PUBLISHED)
  timeline      String?
  completionPercentage Int @default(0)
  googleDriveLink String?
  
  rating        Float?
  review        String?
  
  // Relations
  clientId      String
  client        User     @relation("ClientProjects", fields: [clientId], references: [id])
  freelancers   FreelancerProject[]
  messages      Message[]
  assets        Asset[]
  payments      Payment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Payment {
  id          String   @id @default(uuid())
  amount      Decimal
  type        PaymentType
  status      PaymentStatus @default(PENDING)
  razorpayOrderId String?
  razorpayPaymentId String?

  // Relations
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Many-to-Many Join Table for Freelancers working on Projects
model FreelancerProject {
  id           String   @id @default(uuid())
  projectId    String
  freelancerId String

  project      Project  @relation(fields: [projectId], references: [id])
  freelancer   User     @relation(fields: [freelancerId], references: [id])

  assignedAt   DateTime @default(now())

  @@unique([projectId, freelancerId])
}

model Message {
  id        String   @id @default(uuid())
  content   String
  
  // Relations
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  freelancerId String? // Context ID to separate chats per freelancer for a project

  createdAt DateTime @default(now())
}

model Asset {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
}
